{
  "name": "personal-website-spike",
  "version": "0.1.0",
  "private": true,
  "description": "Patrick MacLyman knowledge-graph notebook — git-backed collections, four live skins, agent MCP.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @notebook/web",
    "check": "npm run check -w @notebook/schema",
    "build": "npm run check && npm run build -w @notebook/web",
    "start": "npm run start -w @notebook/web",
    "lint": "npm run lint -w @notebook/web",
    "mcp": "npm run start -w @notebook/mcp",
    "mcp:http": "npm run http -w @notebook/mcp",
    "mcp:check": "npm run self-test -w @notebook/mcp --",
    "radar": "npm run radar -w @notebook/ingest --",
    "tts-render": "npm run tts-render -w @notebook/ingest --",
    "digest": "bash scripts/digest/run.sh"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "unrs-resolver@1.12.2": true
  }
}
